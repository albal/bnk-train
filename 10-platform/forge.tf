# bnk-forge: F5 DevCentral's web UI for deploying and running BNK.
# It runs under Docker Compose next to the cluster, in bridge mode (the
# docker-compose.local.yml overlay) with a lab overlay that remaps host ports.

locals {
  forge_dir     = var.forge_dir != "" ? var.forge_dir : "${local.root}/bnk-forge"
  forge_compose = "docker compose -f docker-compose.yml -f docker-compose.local.yml -f docker-compose.lab.yml"
}

resource "random_password" "forge_admin" {
  count   = var.enable_forge ? 1 : 0
  length  = 20
  special = false
}

resource "random_password" "forge_mcp" {
  count   = var.enable_forge ? 1 : 0
  length  = 24
  special = false
}

resource "terraform_data" "forge_clone" {
  count = var.enable_forge ? 1 : 0

  input = {
    dir = local.forge_dir
    ref = var.forge_ref
  }

  provisioner "local-exec" {
    command     = <<-EOT
      set -e
      if [ ! -d "${local.forge_dir}/.git" ]; then
        git clone --branch ${var.forge_ref} ${var.forge_repo} "${local.forge_dir}"
      else
        git -C "${local.forge_dir}" fetch --quiet origin ${var.forge_ref}
        git -C "${local.forge_dir}" checkout --quiet FETCH_HEAD
      fi
    EOT
    interpreter = ["bash", "-c"]
  }
}

resource "local_file" "forge_override" {
  count           = var.enable_forge ? 1 : 0
  filename        = "${local.forge_dir}/docker-compose.lab.yml"
  content         = templatefile("${path.module}/templates/forge-lab-override.yml.tftpl", var.forge_ports)
  file_permission = "0644"
  depends_on      = [terraform_data.forge_clone]
}

resource "local_sensitive_file" "forge_env" {
  count           = var.enable_forge ? 1 : 0
  filename        = "${local.forge_dir}/.env"
  file_permission = "0600"
  content         = <<-EOT
    # Generated by Terraform (10-platform/forge.tf)
    DEFAULT_ADMIN_PASSWORD=${random_password.forge_admin[0].result}
    DEFAULT_ADMIN_MUST_CHANGE=false
    MCP_SERVICE_PASSWORD=${random_password.forge_mcp[0].result}
    ENVIRONMENT=development
  EOT
  depends_on      = [terraform_data.forge_clone]
}

# The FAR key goes into bnk-forge's secrets/ (mounted read-only at /app/secrets)
# for its bnk/far-setup module.
resource "local_sensitive_file" "forge_far_key" {
  count           = var.enable_forge && fileexists(var.far_key_path) ? 1 : 0
  filename        = "${local.forge_dir}/secrets/far-credentials.json"
  file_permission = "0600"
  content         = file(var.far_key_path)
  depends_on      = [terraform_data.forge_clone]
}

resource "terraform_data" "forge_deploy" {
  count = var.enable_forge ? 1 : 0

  triggers_replace = [
    terraform_data.forge_clone[0].id,
    local_file.forge_override[0].content,
    local_sensitive_file.forge_env[0].id,
  ]

  input = {
    dir     = local.forge_dir
    compose = local.forge_compose
  }

  provisioner "local-exec" {
    command     = "make -C '${local.forge_dir}' deploy COMPOSE='${local.forge_compose}'"
    interpreter = ["bash", "-c"]
  }

  provisioner "local-exec" {
    when        = destroy
    command     = "[ -d '${self.input.dir}' ] && make -C '${self.input.dir}' down COMPOSE='${self.input.compose}' || true"
    interpreter = ["bash", "-c"]
  }

  depends_on = [local_sensitive_file.forge_far_key]
}
