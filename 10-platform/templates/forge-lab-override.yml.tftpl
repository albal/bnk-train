# Generated by Terraform (10-platform/forge.tf). Layered on top of
# docker-compose.yml + docker-compose.local.yml to remap host ports that
# collide with services already running on this machine.
services:
  postgres:
    ports: !reset []
  redis:
    ports: !reset []
  backend:
    ports: !override
      - "${backend}:8000"
  frontend:
    ports: !override
      - "${frontend}:8080"
  proxy:
    ports: !override
      - "${https}:8443"
      - "${http}:8080"
  mcp:
    ports: !override
      - "${mcp}:8081"
